
# ============================================================
# Ghostty
# ============================================================

# Color system
term = xterm-ghostty
env = TERM_PROGRAM=ghostty
env = COLORTERM=truecolor

theme = Catppuccin Mocha
minimum-contrast = 1.15

# Typography
font-size = 19

# Mouse
mouse-hide-while-typing = true

# Window
window-decoration = none

# Transparency / blur
background-opacity = 0.92
background-blur = 20

# macOS keyboard
macos-option-as-alt = true
macos-titlebar-style = transparent
mouse-hide-while-typing = true
copy-on-select = clipboard

# Cursor
cursor-style = block
cursor-style-blink = true
cursor-opacity = 0.96

keybind = alt+left=unbind
keybind = alt+right=unbind

# Productivity
keybind = super+shift+r=reload_config
keybind = super+shift+o=toggle_background_opacity
keybind = super+alt+enter=toggle_quick_terminal

# Shell
command = /bin/zsh

# SSH integration
shell-integration-features = ssh-env,ssh-terminfo

# Shader
custom-shader = /Users/craftzdog/.config/ghostty/shaders/space.glsl
